<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPP/631 is normally cleartext. Only user-selected printer jobs are sent. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
